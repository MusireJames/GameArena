# ===== BASICS =====
PORT=3000
# Set to production on your live server
NODE_ENV=development
# Your public https address (use an ngrok address while testing at home)
BASE_URL=https://your-domain.com
# Generate with: npm run secret
JWT_SECRET=
PLATFORM_FEE=0.1
DB_FILE=data.db

# ===== LAUNCH MODE =====
# 1 = deposits and staked tables are on. 0 = free play only (safest way to go live before your licence and payment account are approved).
STAKES_ENABLED=1

# ===== PAYMENTS: PALPLUSS (M-Pesa deposits by STK Push, withdrawals by B2C) =====
# PalPluss console > API Keys. Use a test key while testing and the live key (pk_live_...) when real money is allowed.
PALPLUSS_API_KEY=pp_live_552f68c889cd3ea9ddb98a434eb09e1280f18cb6abe3ff10
# Generate with: npm run secret. Part of the webhook address PalPluss calls. Keep it private.
CALLBACK_SECRET=
# Optional: only if you have several payment channels (your till) and want to pick one. Otherwise your default channel is used.
# PALPLUSS_CHANNEL_ID=
# Warn me (by email, see ADMIN_EMAIL) when the PalPluss service wallet drops below this many KES
PALPLUSS_MIN_SERVICE_BALANCE=500
# An M-Pesa prompt nobody answers is given up after this many seconds (if M-Pesa confirms it later it is still credited)
DEPOSIT_EXPIRE_SECONDS=300
# A withdrawal PalPluss cannot pay (wallet empty...) is retried every minute, then refunded to the player after this many minutes
WITHDRAW_QUEUE_MINUTES=15

# ===== KEEPING YOUR DATA SAFE (read DEPLOY.md) =====
# The database is a single file. It MUST live on storage that survives deploys: a Render Persistent Disk (DB_FILE=/var/data/data.db), a VPS disk, or a Docker volume.
# On top of that, set these to copy it off-site every few minutes and once more on every shutdown. If the disk is ever wiped, the server restores itself from the copy on start.
# Works with Cloudflare R2, Backblaze B2, AWS S3 or any S3-compatible storage. Make the bucket PRIVATE.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# R2: auto. AWS: your region, e.g. us-east-1
BACKUP_S3_REGION=auto
# Long random password. Backups are encrypted with it. KEEP A COPY somewhere safe: without it a backup cannot be opened.
BACKUP_KEY=
BACKUP_INTERVAL_MIN=10

# ===== SIGN IN WITH GOOGLE =====
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# ===== VERIFICATION CODES (email) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GameArena <no-reply@yourdomain.com>
# Optional SMS (Africa's Talking)
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# 0 = ask for a code at sign up only, not at every login
LOGIN_OTP=1
# LOCAL TESTING ONLY: shows codes on screen instead of sending them. Remove this line on the live server.
DEV_SHOW_CODES=1

# ===== ADMIN AND SAFETY =====
# Phone numbers (comma separated) that can open /admin.html
ADMIN_PHONES=
# Alerts go here: payments failing, wallet running low, a withdrawal waiting for approval (needs the SMTP settings below)
ADMIN_EMAIL=
# Withdrawals at or above this amount (KES) wait for admin approval
WITHDRAW_REVIEW_OVER=5000

# ===== BUSINESS DETAILS (filled into the footer and legal pages) =====
COMPANY_NAME=
# Your Gambling Regulatory Authority (GRA) licence number
LICENCE_NO=
SUPPORT_EMAIL=
HELPLINE=

# ===== ANDROID APP (only for a Play Store build made with PWABuilder) =====
ANDROID_PACKAGE=
# SHA-256 fingerprint(s) of the app signing key, comma separated
ANDROID_SHA256=

# LOCAL TESTING ONLY: set to 1 if your antivirus causes "self-signed certificate in certificate chain" when sending email. Ignored in production.
# SMTP_TLS_INSECURE=1

# ===== TOURNAMENTS =====
# Share of the prize pool kept by GameArena when a tournament ends (0.1 = 10%). The champion receives the rest in their wallet.
TOURNAMENT_FEE=0.1
# Open tournaments that have not filled up are cancelled and refunded after this many hours
TOURNAMENT_OPEN_HOURS=24
